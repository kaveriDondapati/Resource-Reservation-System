# Copy this file to .env in the project root.
# Each service uses its own database: auth_db, resource_db, reservation_db.
DB_USERNAME=postgres
DB_PASSWORD=your-postgres-password
JWT_SECRET=change-this-to-a-long-secret-key-at-least-32-characters
JWT_EXPIRATION=3600000

# Optional override for one service. Leave this unset for normal local runs.
# DB_URL=jdbc:postgresql://localhost:5432/auth_db
